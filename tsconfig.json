{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./",             // এটি রুট ফোল্ডার থেকে ফাইল খোঁজা শুরু করবে
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": false,             // সাময়িকভাবে এটি false করলে 'any' টাইপ এররগুলো চলে যাবে
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "generated/**/*"], // প্রিজমা জেনারেটেড ফাইল অন্তর্ভুক্ত করুন
  "exclude": ["node_modules"]
}